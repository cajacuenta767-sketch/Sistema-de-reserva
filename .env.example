# ── Base de datos ────────────────────────────────────────────────
# Rol de aplicación: SIN BYPASSRLS. El aislamiento entre organizaciones
# depende de que este rol NO sea dueño de las tablas.
DATABASE_URL=postgres://erp_app:erp_app@127.0.0.1:5432/erp_dev
# Rol de migraciones: dueño del esquema, ejecuta DDL.
DATABASE_MIGRATION_URL=postgres://erp_migrator:erp_migrator@127.0.0.1:5432/erp_dev

# ── API ──────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# ── Autenticación ────────────────────────────────────────────────
JWT_ACCESS_SECRET=cambia-esto-en-produccion-access
JWT_REFRESH_SECRET=cambia-esto-en-produccion-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Almacenamiento de ficheros ───────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# ── Correo ───────────────────────────────────────────────────────
MAIL_DRIVER=console
MAIL_FROM="Nexo ERP <no-reply@example.com>"

# ── Frontend ─────────────────────────────────────────────────────
VITE_API_URL=/api/v1
VITE_APP_NAME=Nexo ERP
