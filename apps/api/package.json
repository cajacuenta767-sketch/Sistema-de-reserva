{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bootstrap/main.ts",
    "build": "tsc -b && node scripts/copy-sql.mjs",
    "start": "node dist/bootstrap/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/platform/db/migrate.cli.ts",
    "db:reset": "tsx src/platform/db/reset.cli.ts",
    "seed": "tsx src/seed/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@erp/contracts": "workspace:*",
    "@erp/core": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "pino": "^9.6.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.0.5"
  }
}
